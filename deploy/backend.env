# Copy to backend/.env on the server and replace example.com with the real domain.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=Ei7f_2WZWwk-1l1jh09q9UFBkp6eZe5hGsqcyR7_Jc7mhbMBVZLrzxhJytItTWjkBGs
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SERVE_FILES=true
# The storefront's address. The payment gateway sends customers back here.
SITE_URL=https://example.com
TIME_ZONE=Asia/Tehran

DB_ENGINE=sqlite

# Switch to melipayamak and fill these once the SMS panel is bought.
SMS_BACKEND=console
SMS_USERNAME=
SMS_PASSWORD=
SMS_PATTERN_OTP=
SMS_PATTERN_ORDER_PLACED=
SMS_PATTERN_ORDER_STATUS=
SMS_PATTERN_ORDER_SHIPPED=
SMS_PATTERN_ADMIN_ORDER=
SMS_PATTERN_BACK_IN_STOCK=
SMS_PATTERN_RETURN_STATUS=

# Online payment. Keep "none" until the Zarinpal merchant id arrives; then set
# PAYMENT_GATEWAY=zarinpal and fill ZARINPAL_MERCHANT_ID. ZARINPAL_SANDBOX=true tests without real money.
PAYMENT_GATEWAY=none
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
PAYMENT_TIMEOUT_MINUTES=20
