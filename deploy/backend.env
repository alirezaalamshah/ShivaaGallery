# Copy to backend/.env on the server and replace example.com with the real domain.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=Ei7f_2WZWwk-1l1jh09q9UFBkp6eZe5hGsqcyR7_Jc7mhbMBVZLrzxhJytItTWjkBGs
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SERVE_FILES=true
# The storefront's address. The payment gateway sends customers back here.
SITE_URL=https://example.com
TIME_ZONE=Asia/Tehran

DB_ENGINE=sqlite

# The seven patterns below are approved (texts: deploy/sms-patterns.md). Set SMS_BACKEND=melipayamak
# once SMS_USERNAME (the panel's username) and SMS_API_KEY (from API_key.txt on the owner's
# computer, never committed) are filled.
SMS_BACKEND=console
SMS_USERNAME=
SMS_API_KEY=
SMS_PATTERN_OTP=574825
SMS_PATTERN_ORDER_PLACED=574827
SMS_PATTERN_ORDER_STATUS=574828
SMS_PATTERN_ORDER_SHIPPED=574831
SMS_PATTERN_ADMIN_ORDER=574832
SMS_PATTERN_BACK_IN_STOCK=574834
SMS_PATTERN_RETURN_STATUS=574835

# Online payment. Keep "none" until Zarinpal approves the merchant; then set
# PAYMENT_GATEWAY=zarinpal. ZARINPAL_MERCHANT_ID comes from API_key.txt on the owner's
# computer and is never committed. ZARINPAL_SANDBOX=true tests without real money.
PAYMENT_GATEWAY=none
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
PAYMENT_TIMEOUT_MINUTES=20
