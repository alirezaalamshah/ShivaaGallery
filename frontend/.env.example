# Address of the Django API as seen from the browser.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Address of the API as seen from the Next.js server (can be an internal address).
INTERNAL_API_URL=http://127.0.0.1:8000/api
# Public address of the storefront, for the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
