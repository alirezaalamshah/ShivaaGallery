# Copy to .env and adjust. Never commit the real .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
TIME_ZONE=Asia/Tehran
SITE_URL=http://localhost:3100

# sqlite (default) or postgresql
DB_ENGINE=sqlite
DB_NAME=store
DB_USER=store
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# SMS: console (prints to server log) or melipayamak
SMS_BACKEND=console
# Melipayamak panel username, and its API key (sent in place of the password)
SMS_USERNAME=
SMS_API_KEY=
# Approved Melipayamak pattern codes (bodyId). Texts: deploy/sms-patterns.md
SMS_PATTERN_OTP=
SMS_PATTERN_ORDER_PLACED=
SMS_PATTERN_ORDER_STATUS=
SMS_PATTERN_ORDER_SHIPPED=
SMS_PATTERN_ADMIN_ORDER=
SMS_PATTERN_BACK_IN_STOCK=
SMS_PATTERN_RETURN_STATUS=

# Online payment: none, fake (local testing only) or zarinpal
PAYMENT_GATEWAY=none
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
PAYMENT_TIMEOUT_MINUTES=20
