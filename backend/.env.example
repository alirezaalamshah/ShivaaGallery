# Copy to .env and adjust. Never commit the real .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
TIME_ZONE=Asia/Tehran

# sqlite (default) or postgresql
DB_ENGINE=sqlite
DB_NAME=store
DB_USER=store
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# SMS: console (prints to server log) or melipayamak
SMS_BACKEND=console
SMS_USERNAME=
SMS_PASSWORD=
# Approved Melipayamak pattern ids (bodyId)
SMS_PATTERN_OTP=
SMS_PATTERN_ORDER_PLACED=
SMS_PATTERN_ORDER_STATUS=
